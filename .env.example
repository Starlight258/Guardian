# Colon-separated Obsidian vault paths. Add as many vaults as needed.
# Example:
# GUARDIAN_OBSIDIAN_PATHS=/Users/mae/Documents/Obsidian/Main:/Users/mae/Documents/Obsidian/Work
GUARDIAN_OBSIDIAN_PATHS=

# Local Chroma persistence path for Guardian chunk vectors.
GUARDIAN_CHROMA_PATH=data/chroma

# Embedding and graph defaults. Changing the embedding model requires reindexing Chroma.
GUARDIAN_EMBEDDING_MODEL=BAAI/bge-m3
GUARDIAN_GRAPH_SIMILARITY_THRESHOLD=0.75
GUARDIAN_GRAPH_TOP_K=10
